# Server Configuration
LISTEN_ADDR=:8080

# Upstream Provider Configuration
UPSTREAM_BASE_URL=https://openrouter.ai/api/v1
UPSTREAM_API_KEY=your-api-key-here

# Proxy Pool Configuration
PROXY_POOL_SIZE=3
PROXY_BASE_PORT=10801
WARP_IMAGE=caomingjun/warp:latest

# Rate Limit Configuration
RATE_LIMIT_COOLDOWN=5m
MAX_RETRIES=3
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=30s

# Health Check
HEALTH_CHECK_PERIOD=30s

# Resource Limits (per container)
RESOURCE_CPU_LIMIT=0.25
RESOURCE_MEMORY_LIMIT=64M

# Concurrency
MAX_CONCURRENT=100

# Sticky Session
STICKY_SESSION_TTL=10m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Request Timeout
REQUEST_TIMEOUT=60s
