# Server Configuration
LISTEN_ADDR=:8082

# Upstream Configuration
# OpenCode Zen (default): https://opencode.ai/zen/v1
# OpenCode Zen Go (cheaper tier): https://opencode.ai/zen/go/v1
# Auth: leave UPSTREAM_API_KEY empty to use the public tier — the gateway
# then sends "x-api-key: public" upstream automatically. Client requests may
# override with their own Bearer token.
# Multiple keys: comma-separated list, a random one is picked per request to
# spread quota/rate limits. Entries: "public", "zent-", or "header:value".
UPSTREAM_BASE_URL=https://opencode.ai/zen/v1
UPSTREAM_API_KEY=
UPSTREAM_API_KEYS=

# Gateway API keys (comma-separated). When set, all /v1/* endpoints require
# "Authorization: Bearer <key>" with one of these keys; anything else gets a
# 401 authentication_error. Leave empty to keep /v1/* open (default).
GATEWAY_API_KEYS=

# Built-in web_search tool (zen driver only; disabled for opencode drivers).
# When enabled, chat requests get a web_search function injected; when the
# model calls it, the gateway searches server-side (egress through the same
# rotating VPN IP) and feeds results back for another round.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_PAGES=2
WEB_SEARCH_MAX_PAGE_CHARS=6000
WEB_SEARCH_MAX_ROUNDS=3
# Search provider selection (optional):
#   SEARXNG_URL=https://searx.example.org   # self-hosted SearXNG (JSON API)
#   BRAVE_API_KEY=...                        # Brave Search API
# If neither is set, keyless DuckDuckGo HTML is used.
SEARXNG_URL=
BRAVE_API_KEY=

# Upstream driver selection.
#   zen          → call OpenCode Zen (OpenAI-compatible), via per-container VPN IP
#   opencode     → drive an `opencode serve` instance (OpenCode Server HTTP API)
#                 at OPENCODE_SERVER_URL; each request still egresses through a
#                 fresh VPN container so the agent acts from a unique IP.
#   opencode-cli → the opencode CLI is baked into every VPN container (built
#                 automatically at startup) and `opencode run` is docker-exec'd
#                 per request inside the container — the agent's egress IP is
#                 the container's VPN IP. Requires real provider credentials:
#                 send the client Authorization token (e.g. "Bearer sk-ant-...")
#                 and it is injected as OPENCODE_CLI_PROVIDER_ENV per exec.
UPSTREAM_PROVIDER=zen

# OpenCode Server (UPSTREAM_PROVIDER=opencode) settings. The OpenCode Server
# itself can be remote; its URL just must be reachable through the chosen proxy
# container's SOCKS5 tunnel (e.g. a publicly reachable host, or reached via the
# docker bridge gateway 172.17.0.1 for a host-local server).
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=
OPENCODE_PROVIDER_ID=
OPENCODE_MODEL=

# opencode-cli (UPSTREAM_PROVIDER=opencode-cli) settings.
# OPENCODE_CLI_MODEL: model override for `opencode run --model` (empty = the
#   CLI's own default; otherwise the client's "model" field is passed through).
# OPENCODE_CLI_PROVIDER_ENV: container env var that receives the client's
#   credential per exec. Default ANTHROPIC_API_KEY — set to OPENAI_API_KEY,
#   GEMINI_API_KEY, etc. to match your provider.
# OPENCODE_CLI_ARGS: extra `opencode run` args, space-separated (e.g.
#   "--agent build").
# OPENCODE_CLI_MODELS: comma-separated model list served by /v1/models.
#   Empty = live `opencode models` output from inside a container.
OPENCODE_CLI_MODEL=
OPENCODE_CLI_PROVIDER_ENV=ANTHROPIC_API_KEY
OPENCODE_CLI_ARGS=
OPENCODE_CLI_MODELS=

# Proxy Pool Configuration
PROXY_POOL_SIZE=3
PROXY_BASE_PORT=10801
# Duplicate egress IP handling: a fresh proxy whose IP matches an existing
# pool proxy is rotated (container replaced) up to this many times before one
# duplicate is kept. Values <= 1 disable extra rotation.
PROXY_IP_ROTATE_ATTEMPTS=3

# ProtonVPN Configuration
# VPN_IMAGE: Docker image for VPN containers (wireguard-tools + gost SOCKS5)
VPN_IMAGE=ghcr.io/tprasadtp/protonwire:latest
# PROTONVPN_USERNAME: ProtonVPN OpenVPN username (email)
PROTONVPN_USERNAME=your-email@example.com
# PROTONVPN_PASSWORD: ProtonVPN OpenVPN password
PROTONVPN_PASSWORD=your-password
# PROTONVPN_API_BASE: ProtonVPN API base URL
PROTONVPN_API_BASE=https://account.protonvpn.com
# PROTONVPN_STORE_PATH: SQLite3 path for credential storage
PROTONVPN_STORE_PATH=data/protonvpn.db
# PROTONVPN_REGIONS: Server region filter (comma-separated country codes)
PROTONVPN_REGIONS=NL,US,JP,DE
# PROTONVPN_IP_CHECK_URL: URL to verify egress IP (default: icanhazip.com)
PROTONVPN_IP_CHECK_URL=https://icanhazip.com/

# Rate Limit Configuration
RATE_LIMIT_COOLDOWN=5m
# Retry-After seconds sent to clients when upstream rate limits persist across all retries (429)
RATE_LIMIT_RETRY_AFTER=60
# How long an egress IP is banned after an upstream 429 (no request is routed
# through it, and no new container may reuse it). Extended by the upstream's
# Retry-After header when present.
IP_BAN_DURATION=10m
# How long the gateway waits (per request) for a fresh, unbanned proxy to boot
# after all pool IPs are rate limited, before giving up with 429. Covers VPN
# container startup (~40-90s).
RATE_LIMIT_FRESH_IP_WAIT=90s
MAX_RETRIES=3
RETRY_BASE_DELAY=1s
RETRY_MAX_DELAY=30s

# Health Check
HEALTH_CHECK_PERIOD=30s

# Resource Limits (per container)
RESOURCE_CPU_LIMIT=0.25
RESOURCE_MEMORY_LIMIT=512M

# Concurrency
MAX_CONCURRENT=100

# Sticky Session
STICKY_SESSION_TTL=10m

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Request Timeout
REQUEST_TIMEOUT=60s

# Metrics (SQLite)
METRICS_DB_PATH=data/metrics.db

# Model list filter: /v1/models keeps only models whose name contains this
# substring (case-insensitive). Empty string disables the filter.
MODEL_FILTER=-free

# Docker Compose
GATEWAY_PORT=8082
